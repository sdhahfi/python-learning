def BMI():
    weight = float(input("Enter your weight in kg: "))
    height = float(input("Enter your height in meters: "))
    bmi = weight / (height ** 2)
    if bmi < 18.5:
        print("You are underweight.")
    elif 18.5 <= bmi < 24.9:
        print("You have a normal weight.")
    else:
        print("You are overweight.")    
    print(f"Your BMI is: {bmi:.2f}")
    return bmi
bmi_value = BMI()
